{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "O que a janela do Tra\u00e7o pode fazer no computador",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:default",
    "updater:default",
    "process:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPLOCALDATA/recovery-v1" }, { "path": "$APPLOCALDATA/recovery-v1/**" }] },
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "$APPLOCALDATA/recovery-v1" }, { "path": "$APPLOCALDATA/recovery-v1/**" }] },
    { "identifier": "fs:allow-stat", "allow": [{ "path": "$APPLOCALDATA/recovery-v1/**" }] },
    { "identifier": "fs:allow-rename", "allow": [{ "path": "$APPLOCALDATA/recovery-v1/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPLOCALDATA/recovery-v1/**" }] },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
