{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "O que a janela do Traço pode fazer no computador",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
