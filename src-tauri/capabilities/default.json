{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "O que a janela do Tra\u00e7o pode fazer no computador",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:default",
    "updater:default",
    "process:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}